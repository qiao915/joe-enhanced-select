{
  "name": "joe-enhanced-select",
  "version": "1.0.0",
  "description": "一个功能强大、易于使用的增强型选择组件，支持静态选项、异步加载、多选、搜索等功能。",
  "keywords": [
    "react",
    "component",
    "select",
    "dropdown",
    "autocomplete",
    "search",
    "multiselect",
    "ui",
    "joe-enhanced-select",
    "enhanced-select",
    "joeEnhancedSelect",
    "joeenhancedselect"
  ],
  "author": "Joe Wu",
  "license": "MIT",
  "homepage": "https://github.com/qiao915/joe-enhanced-select#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiao915/joe-enhanced-select.git"
  },
  "bugs": {
    "url": "https://github.com/qiao915/joe-enhanced-select/issues"
  },
  "type": "module",
  "main": "./dist/joe-enhanced-select.cjs.js",
  "module": "./dist/joe-enhanced-select.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/joe-enhanced-select.es.js",
      "require": "./dist/joe-enhanced-select.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": ">= 16.8",
    "react-dom": ">= 16.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/types": "^29.6.3",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/blocks": "^7.6.17",
    "@storybook/react": "^7.6.17",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "peerDependencies": {
    "react": ">= 16.8",
    "react-dom": ">= 16.8"
  }
}
